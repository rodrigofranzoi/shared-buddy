    "Matching items stay blurred until unlocked, then remain visible for 10 minutes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matching items stay blurred until unlocked, then remain visible for 10 minutes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overeenkomende items blijven wazig tot ontgrendeling en blijven daarna 10 minuten zichtbaar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens correspondentes ficam desfocados até desbloqueio e depois permanecem visíveis por 10 minutos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos coincidentes permanecen desenfocados hasta desbloquearse y luego visibles 10 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments correspondants restent floutés jusqu’au déverrouillage, puis visibles 10 minutes."

    "Copies made while these apps are frontmost are not saved to Clipboard Buddy history.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies made while these apps are frontmost are not saved to Clipboard Buddy history."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieën gemaakt terwijl deze apps vooraan staan, worden niet in de geschiedenis van Clipboard Buddy opgeslagen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias feitas com estes apps em primeiro plano não são salvas no histórico do Clipboard Buddy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias hechas con estas apps en primer plano no se guardan en el historial de Clipboard Buddy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies faites lorsque ces apps sont au premier plan ne sont pas enregistrées dans l’historique de Clipboard Buddy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",

    "Used when you click a color in history or pick from the color panel. Also controls how colors are shown in lists.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when you click a color in history or pick from the color panel. Also controls how colors are shown in lists."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt wanneer je een kleur in de geschiedenis aanklikt of via het kleurenpaneel kiest. Bepaalt ook hoe kleuren in lijsten worden getoond."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado ao clicar numa cor no histórico ou ao escolher no painel de cores. Também controla como as cores aparecem nas listas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa al hacer clic en un color del historial o al elegir en el panel. También controla cómo se muestran en las listas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé quand vous cliquez une couleur dans l’historique ou prélevez via le panneau. Contrôle aussi l’affichage dans les listes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato quando fai clic su un colore nella cronologia o scegli dal pannello. Controlla anche come i colori appaiono negli elenchi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم عند النقر على لون في السجل أو الاختيار من لوحة الألوان. ويتحكم أيضًا في عرض الألوان في القوائم."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "点击历史中的颜色或从颜色面板取色时使用。也控制列表中的颜色显示方式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется при клике по цвету в истории или выборе на панели. Также влияет на отображение в списках."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴の色をクリックしたときやカラーパネルから選んだときに使います。リスト表示にも反映されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, wenn Sie eine Farbe in der Historie anklicken oder im Farbpanel wählen. Steuert auch die Anzeige in Listen."
          }
        }
      },
      "extractionState": "manual"
    },

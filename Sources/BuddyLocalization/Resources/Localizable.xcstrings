    "Open %@ when you log in?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open %@ when you log in?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ openen wanneer u inlogt?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir %@ ao iniciar sessão?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Abrir %@ al iniciar sesión?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir %@ à la connexion ?"
          }
        },
        "it": {

    },
    "Older clippings beyond the remember limit are removed automatically. Favorites are kept separately.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older clippings beyond the remember limit are removed automatically. Favorites are kept separately."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oudere knipsels boven de bewaarlimiet worden automatisch verwijderd. Favorieten blijven apart bewaard."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortes antigos além do limite são removidos automaticamente. Favoritos são mantidos à parte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recortes antiguos que superen el límite se eliminan automáticamente. Los favoritos se guardan aparte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extraits trop anciens sont supprimés automatiquement. Les favoris sont conservés à part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I ritagli oltre il limite vengono rimossi automaticamente. I preferiti restano separati."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف القصاصات الأقدم تلقائيًا عند تجاوز الحد. تُحفظ المفضلة بشكل منفصل."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "超出记忆上限的旧剪贴条目会自动删除。收藏单独保留。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые вырезки сверх лимита удаляются автоматически. Избранное хранится отдельно."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶上限を超えた古いクリップは自動削除されます。お気に入りは別管理です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältere Ausschnitte über dem Speicherlimit werden automatisch entfernt. Favoriten bleiben separat erhalten."
          }
        }
      },
      "extractionState": "manual"
    },

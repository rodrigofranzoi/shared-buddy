          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُحفظ النُسخ أثناء كون هذه التطبيقات في الواجهة في سجل Clipboard Buddy."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这些应用位于前台时的复制不会保存到 Clipboard Buddy 历史记录。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии, сделанные когда эти приложения на переднем плане, не сохраняются в истории Clipboard Buddy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアプリが最前面のときのコピーは Clipboard Buddy の履歴に保存されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",

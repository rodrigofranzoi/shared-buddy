          }
        }
      },
      "extractionState": "manual"
    },
    "While paused, new clipboard or screenshot captures are not saved. Permanent pause survives relaunch until you resume.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While paused, new clipboard or screenshot captures are not saved. Permanent pause survives relaunch until you resume."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens een pauze worden nieuwe klembord- of screenshotopnamen niet opgeslagen. Een permanente pauze blijft na herstarten tot je hervat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa, novas capturas da área de transferência ou de tela não são salvas. A pausa permanente permanece após reiniciar até você retomar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa no se guardan nuevas capturas del portapapeles o de pantalla. La pausa permanente sigue tras reiniciar hasta que reanudes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause, les nouvelles captures du presse-papiers ou d’écran ne sont pas enregistrées. La pause permanente persiste après redémarrage jusqu’à reprise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa, le nuove catture di appunti o screenshot non vengono salvate. La pausa permanente resta dopo il riavvio finché non riprendi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء الإيقاف المؤقت لا تُحفظ نُسخ الحافظة أو لقطات الشاشة الجديدة. يستمر الإيقاف الدائم بعد إعادة التشغيل حتى تستأنف."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停期间不会保存新的剪贴板或截图。永久暂停在重新启动后仍然有效，直到你继续。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На паузе новые записи буфера или снимки не сохраняются. Постоянная пауза сохраняется после перезапуска, пока вы не возобновите."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中は新しいクリップボードやスクリーンショットは保存されません。永続一時停止は再開するまで再起動後も続きます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Pause werden neue Zwischenablage- oder Screenshot-Erfassungen nicht gespeichert. Eine dauerhafte Pause bleibt nach Neustart bis zum Fortsetzen bestehen."
          }
        }
      },
      "extractionState": "manual"
    },
    "We can’t copy this kind of content. Pornography and sexual material aren’t allowed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can’t copy this kind of content. Pornography and sexual material aren’t allowed."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit soort inhoud kunnen we niet kopiëren. Pornografie en seksueel materiaal zijn niet toegestaan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não podemos copiar este tipo de conteúdo. Pornografia e material sexual não são permitidos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podemos copiar este tipo de contenido. No se permite pornografía ni material sexual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne pouvons pas copier ce type de contenu. La pornographie et le contenu sexuel ne sont pas autorisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non possiamo copiare questo tipo di contenuto. Pornografia e materiale sessuale non sono consentiti."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكننا نسخ هذا النوع من المحتوى. المواد الإباحية والجنسية غير مسموح بها."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法复制此类内容。不允许色情或性相关材料。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы не можем копировать такой контент. Порнография и материалы сексуального характера запрещены."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この種のコンテンツはコピーできません。ポルノや性的な内容は許可されていません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Art von Inhalt kann nicht kopiert werden. Pornografie und sexuelles Material sind nicht erlaubt."
          }
        }
      },
      "extractionState": "manual"
    },

        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى العناصر المطابقة مطموسة حتى إلغاء القفل، ثم تظل مرئية لمدة ١٠ دقائق."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配项在解锁前保持模糊，之后可见 10 分钟。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совпадения остаются размытыми до разблокировки, затем видны 10 минут."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",

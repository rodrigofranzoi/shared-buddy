        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Typen bleiben verborgen, bis sie mit Passwort oder Touch ID entsperrt werden."
          }
        }
      },
      "extractionState": "manual"
    },
    "These types are detected and blurred in the screenshot editor.": {

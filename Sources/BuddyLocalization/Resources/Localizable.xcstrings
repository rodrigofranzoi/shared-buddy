            "value": "If %@ helps your workflow, a quick rating on the App Store means a lot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als %@ je workflow helpt, betekent een snelle beoordeling in de App Store veel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o %@ ajuda o seu fluxo de trabalho, uma avaliação rápida na App Store significa muito."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si %@ ayuda a tu flujo de trabajo, una valoración rápida en el App Store significa mucho."
          }
        },
        "fr": {

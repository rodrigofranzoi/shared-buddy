          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passende Einträge bleiben unscharf bis zur Entsperrung und sind danach 10 Minuten sichtbar."
          }
        }
      },
      "extractionState": "manual"
    },

    "These types stay hidden until unlocked with password or Touch ID.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These types stay hidden until unlocked with password or Touch ID."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze typen blijven verborgen tot ontgrendeling met wachtwoord of Touch ID."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses tipos ficam ocultos até desbloqueio com senha ou Touch ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos tipos permanecen ocultos hasta desbloquearse con contraseña o Touch ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
